cabal-version: 3.0
name:          calchs
version:       0.0.1.1

synopsis:      Command line calculator tool.
description:   A simple command line calculator tool.
license:       MIT
author:        Daniel Barenholz
maintainer:    hello@dbarenholz.com

common commonOptions
  ghc-options:      -Wall
  default-language: Haskell2010
  other-modules:    Paths_calchs

library
  import:           commonOptions
  exposed-modules:  Calc.Lexer, Calc.Parser, Calc.Evaluator, Calc.Types, Calc.Utils, Calc.Interactive, Calc
  hs-source-dirs:   src
  build-depends:
    base,
    haskeline,
    mtl

executable calchs
  import:           commonOptions
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    base,
    calchs

test-suite spec
  import:           commonOptions
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  other-modules:
    Calc.LexerSpec,
    Calc.ParserSpec,
    Calc.EvaluatorSpec,
    Calc.InteractiveSpec,
    CalcSpec,
  build-depends:
    base,
    hspec ==2.*,
    calchs
  build-tool-depends:
    hspec-discover:hspec-discover == 2.*
